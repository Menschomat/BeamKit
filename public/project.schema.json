{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "lamp-attachment-project"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "units": {
      "type": "string",
      "const": "mm"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "engine": {
      "type": "object",
      "properties": {
        "generatorVersion": {
          "type": "string",
          "enum": [
            "0.2.0",
            "0.3.0"
          ]
        },
        "kernel": {
          "type": "string",
          "const": "manifold"
        },
        "kernelVersion": {
          "type": "string",
          "const": "3.5.5"
        }
      },
      "required": [
        "generatorVersion",
        "kernel",
        "kernelVersion"
      ],
      "additionalProperties": false
    },
    "lamp": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "mount": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "revision": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "parameters": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "number"
              }
            }
          },
          "required": [
            "id",
            "revision",
            "parameters"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "attachment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "required": [
        "id",
        "revision",
        "parameters"
      ],
      "additionalProperties": false
    },
    "assembly": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "integrated",
            "fit-test",
            "standalone"
          ]
        },
        "connection": {
          "type": "null"
        }
      },
      "required": [
        "mode",
        "connection"
      ],
      "additionalProperties": false
    },
    "printProfile": {
      "type": "object",
      "properties": {
        "printer": {
          "type": "string",
          "const": "bambu-lab"
        },
        "nozzleDiameterMm": {
          "type": "number",
          "const": 0.4
        },
        "material": {
          "type": "string",
          "enum": [
            "unspecified",
            "PLA",
            "PETG",
            "ASA"
          ]
        }
      },
      "required": [
        "printer",
        "nozzleDiameterMm",
        "material"
      ],
      "additionalProperties": false
    },
    "export": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "stl",
            "3mf"
          ]
        },
        "quality": {
          "type": "string",
          "const": "print"
        },
        "orientation": {
          "type": "string",
          "enum": [
            "front-down",
            "assembly"
          ]
        }
      },
      "required": [
        "format",
        "quality",
        "orientation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "units",
    "name",
    "engine",
    "lamp",
    "mount",
    "attachment",
    "assembly",
    "printProfile",
    "export"
  ],
  "additionalProperties": false
}
